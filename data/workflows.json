[
  {
    "id": "issue-pipeline",
    "name": "이슈 처리 파이프라인",
    "team": "제품팀",
    "author": "Jane, Leo, Kyum",
    "description": "VoC 수집부터 코드 머지까지. 6개 에이전트 + 3개 사람 역할. 에이전트는 초안/판정까지, 승인·머지·배포는 사람.",
    "steps": [
      {
        "id": "voc-trigger",
        "name": "VoC 제보",
        "type": "trigger",
        "description": "Gmail, App Store, Google Play에서 사용자 제보 유입",
        "next": [
          "voc-triage"
        ]
      },
      {
        "id": "voc-triage",
        "name": "VoC Triage",
        "type": "agent",
        "description": "수집, 분류, Amplitude 분석, 답변/티켓 초안 생성",
        "tools": [
          "Gmail",
          "App Store",
          "Google Play",
          "Google Sheets",
          "Amplitude",
          "Notion",
          "Linear",
          "Slack"
        ],
        "trigger": "매일 07:00 + 30분 주기 cronjob",
        "output": "분류된 이슈 + Gmail 답변 초안 + Linear 티켓 초안",
        "next": [
          "voc-approver"
        ]
      },
      {
        "id": "voc-approver",
        "name": "VoC 승인자",
        "type": "human",
        "who": "Kyum",
        "description": "원문 확인, 직접 재현, 티켓 생성 승인 (기록 없는 승인 무효)",
        "tools": [
          "Gmail",
          "Google Sheets",
          "Slack",
          "Linear"
        ],
        "output": "승인된 Linear 티켓 or 추가 정보 요청 답변 발송",
        "next": [
          "priority-strategist"
        ],
        "exitCondition": "이슈 아님 → 추가 정보 요청 후 종료"
      },
      {
        "id": "priority-strategist",
        "name": "Priority Strategist",
        "type": "agent",
        "description": "impact × volume × segment / effort 기반 우선순위 산정",
        "tools": [
          "Amplitude",
          "Linear"
        ],
        "trigger": "매주 수,목 제외 오후 1시",
        "output": "우선순위 라벨 + 분해 근거 댓글 → Planned 이동",
        "next": [
          "bug-fixer"
        ]
      },
      {
        "id": "bug-fixer",
        "name": "Bug Fixer",
        "type": "agent",
        "description": "재현, 원인 분석, 자기검증 게이트 통과 후 draft PR 생성",
        "tools": [
          "Amplitude",
          "Linear",
          "GitHub",
          "Figma",
          "Slack"
        ],
        "trigger": "Linear Planned + approved 라벨",
        "output": "Draft PR + 재현/원인/테스트 근거",
        "next": [
          "perf-guardian"
        ]
      },
      {
        "id": "perf-guardian",
        "name": "Perf Guardian",
        "type": "agent",
        "description": "PR 정적 게이트 — typecheck/build 이진 게이트 + diff risk tags",
        "tools": [
          "GitHub"
        ],
        "trigger": "PR CI 완료 감지",
        "output": "CONFIRMED / REJECTED / INCONCLUSIVE + risk tags",
        "next": [
          "red-team"
        ],
        "rejectTo": "bug-fixer"
      },
      {
        "id": "red-team",
        "name": "Red Team",
        "type": "agent",
        "description": "코드 리뷰 — RN 함정 체크리스트, OTA 롤백 경로, 버전 호환성",
        "tools": [
          "GitHub",
          "Linear",
          "Slack",
          "Amplitude",
          "Crashlytics"
        ],
        "trigger": "Perf Guardian CONFIRMED",
        "output": "PASS / CONDITIONAL / BLOCK + Pn 태그 + file:line 근거",
        "next": [
          "issue-assignee"
        ],
        "rejectTo": "bug-fixer"
      },
      {
        "id": "issue-assignee",
        "name": "이슈 담당자",
        "type": "human",
        "who": "Jane / Leo",
        "description": "Draft PR 검토, 추가 수정, ready 전환, 리뷰어 등록",
        "tools": [
          "GitHub",
          "Linear"
        ],
        "output": "Ready PR + 리뷰어 지정",
        "next": [
          "code-reviewer"
        ]
      },
      {
        "id": "code-reviewer",
        "name": "코드 리뷰 담당자",
        "type": "human",
        "who": "Jane / Leo",
        "description": "최종 코드 리뷰 → 승인 (1명 이상, branch protection)",
        "tools": [
          "GitHub",
          "Linear"
        ],
        "output": "Approved PR",
        "next": [
          "merge"
        ]
      },
      {
        "id": "merge",
        "name": "Merge",
        "type": "human",
        "who": "담당 개발자",
        "description": "에이전트는 merge/deploy/rollback 절대 불가. 사람만 실행.",
        "output": "코드 머지 완료",
        "next": []
      }
    ],
    "parallel": [
      {
        "id": "incident-responder",
        "name": "Incident Responder",
        "type": "agent",
        "description": "15분 주기 Crashlytics/Amplitude 감시. P0 초과 시 인시던트 보고 + 완화 draft PR",
        "tools": [
          "Crashlytics",
          "Amplitude",
          "GitHub",
          "Slack"
        ],
        "trigger": "15분 주기",
        "output": "인시던트 보고 + 완화 draft PR → 사람이 rollback/deploy 실행",
        "label": "상시 병렬"
      }
    ]
  },
  {
