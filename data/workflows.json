  {
    "id": "creator-outreach",
    "name": "크리에이터 발굴 → 아웃리치",
    "team": "그로스팀",
    "author": "Dina",
    "description": "유튜브·인스타·틱톡에서 루틴 크리에이터를 찾아 명단화하고 컨택하는 흐름. 수집은 자동, 누구에게 연락할지는 사람이 판단합니다.",
    "steps": [
      {
        "id": "campaign-start",
        "name": "캠페인 시작",
        "type": "trigger",
        "description": "협업 크리에이터 발굴이 필요한 시점 (신규 캠페인, 명단 소진)",
        "next": [
          "youtube-collector",
          "creator-collector"
        ]
      },
      {
        "id": "youtube-collector",
        "name": "유튜브 크리에이터 수집",
        "type": "agent",
        "description": "YouTube 공식 API로 루틴 관련 채널 수집, 구독자 수 필터링, 소개글에서 이메일 추출",
        "tools": [
          "YouTube Data API",
          "Google Sheets"
        ],
        "trigger": "수동 실행 (1회 최대 200명, 하루 4~5회)",
        "output": "채널 명단 CSV / 구글시트",
        "next": [
          "list-review"
        ]
      },
      {
        "id": "creator-collector",
        "name": "크리에이터 수집 (인스타·틱톡)",
        "type": "agent",
        "description": "해시태그·검색어 기반 크리에이터 수집, 팔로워·소개·공개 이메일 확보",
        "tools": [
          "Instagram",
          "TikTok",
          "Google Sheets"
        ],
        "trigger": "수동 실행 (1회 20~40명, 속도 제한 있음)",
        "output": "크리에이터 명단 CSV / 구글시트",
        "next": [
          "list-review"
        ]
      },
      {
        "id": "list-review",
        "name": "명단 검토",
        "type": "human",
        "who": "Dina",
        "description": "중복·부적합 계정 제거, 브랜드 적합도 판단, 컨택 우선순위 지정",
        "tools": [
          "Google Sheets"
        ],
        "output": "컨택 대상 확정 명단",
        "next": [
          "outreach-send"
        ],
        "exitCondition": "적합 크리에이터 없음 → 검색어 조정 후 재수집"
      },
      {
        "id": "outreach-send",
        "name": "컨택 발송",
        "type": "human",
        "who": "Dina",
        "description": "확보한 이메일·DM으로 협업 제안 발송, 응답 관리",
        "tools": [
          "Gmail",
          "Instagram"
        ],
        "output": "발송된 제안 + 응답 현황",
        "next": [
          "event-post"
        ]
      },
      {
        "id": "event-post",
        "name": "이벤트 게시물 오픈",
        "type": "trigger",
        "description": "협업 확정 후 참여형 이벤트 게시물 업로드",
        "next": [
          "instagram-dm-bot"
        ]
      },
      {
        "id": "instagram-dm-bot",
        "name": "인스타 댓글→DM 봇",
        "type": "agent",
        "description": "게시물 댓글에 지정 키워드가 달리면 참여자에게 자동으로 DM 발송 (중복 발송 방지)",
        "tools": [
          "Instagram",
          "Meta Graph API"
        ],
        "trigger": "게시물 ID + 키워드 등록 후 실행",
        "output": "자동 발송된 DM + 발송 기록",
        "next": []
      }
    ]
