  {
    "id": "aso-experiment",
    "name": "ASO 스토어 실험 사이클",
    "team": "그로스팀",
    "author": "Dina",
    "description": "스토어 전환율 진단부터 스크린샷 A/B 실험 결과 판정까지. 에이전트가 가설과 브리프까지 만들고, 에셋 제작·실험 등록·최종 판단은 사람이 합니다.",
    "steps": [
      {
        "id": "cycle-start",
        "name": "사이클 시작",
        "type": "trigger",
        "description": "직전 실험 종료 또는 스토어 지표 점검 시점",
        "next": [
          "aso-tool",
          "aso-diagnose"
        ]
      },
      {
        "id": "aso-tool",
        "name": "ASO Tool (키워드 점검)",
        "type": "agent",
        "description": "앱 키워드의 ASO 점수와 개선안 확인 — 사이클 진입 전 참고용",
        "tools": [
          "Google Play"
        ],
        "trigger": "웹앱에서 수동 조회",
        "output": "ASO 점수 + 키워드별 개선안",
        "next": [
          "aso-diagnose"
        ]
      },
      {
        "id": "aso-diagnose",
        "name": "진단 · 경쟁분석 · 가설",
        "type": "agent",
        "description": "전환율을 카테고리 벤치마크와 비교해 병목을 찾고, 경쟁사 스토어를 분석해 실험 가설을 세움",
        "tools": [
          "Google Play Console",
          "BigQuery"
        ],
        "trigger": "python3 main.py start",
        "output": "진단 리포트 + 가설 후보 + 선택된 가설",
        "next": [
          "checkpoint-a"
        ]
      },
      {
        "id": "checkpoint-a",
        "name": "체크포인트 A — 가설·실험 설계 승인",
        "type": "human",
        "who": "Dina",
        "description": "가설이 앱 실제 기능과 맞는지, 실험 설계가 가설을 검증하는지 확인 후 승인",
        "output": "승인된 실험 스펙 + 크리에이티브 브리프",
        "next": [
          "asset-design"
        ],
        "rejectTo": "aso-diagnose"
      },
      {
        "id": "asset-design",
        "name": "에셋 제작",
        "type": "human",
        "who": "디자이너",
        "description": "크리에이티브 브리프대로 control·variant 스크린샷 제작 (1080×1920 JPEG)",
        "tools": [
          "Figma"
        ],
        "output": "control + variant 스크린샷 2장",
        "next": [
          "checkpoint-b"
        ]
      },
      {
        "id": "checkpoint-b",
        "name": "체크포인트 B — 실험 등록",
        "type": "human",
        "who": "Dina",
        "description": "에셋을 Play Console 실험에 등록하고 실험 ID·예상 종료일을 에이전트에 입력",
        "tools": [
          "Google Play Console"
        ],
        "output": "실행 중인 스토어 실험",
        "next": [
          "experiment-poll"
        ]
      },
      {
        "id": "experiment-poll",
        "name": "실험 모니터링 · 평가",
        "type": "agent",
        "description": "실험 기간 동안 지표를 주기적으로 확인하고, 종료 시 통계적 유의성과 방향성을 판정",
        "tools": [
          "Google Play Console"
        ],
